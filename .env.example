# ChargeNeighbor Environment Variables Configuration
# Copy this file to .env for local development, or configure these variables in your deployment settings (e.g., Vercel).
# NEVER commit your actual API keys or secrets to git.

# Supabase Configuration (Required for live production cloud database & auth)
# Get these from your Supabase Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Google Maps Platform (Optional: For native Google Maps rendering)
# If left blank, ChargeNeighbor uses the interactive Leaflet mapping engine with live OpenStreetMap tiles,
# while always maintaining full Google Maps Directions navigation links.
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here
